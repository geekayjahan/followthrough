# Copy this file to .env and fill in what you need. .env is gitignored — never commit it.

# Your app's external API key(s) go here — added live at S2's credential checkpoint.
# One line per key: SERVICE_KEY=value. Never commit real values.

# ANTHROPIC_API_KEY — only if you build against the API directly.
# With a Claude Pro/Max plan, skip this — Claude Code uses your plan auth.
ANTHROPIC_API_KEY=

# Langfuse — observability for LLM calls and server-side spans. Optional;
# S3's OBSERVE step is demoed live in the session. Create a project at
# https://cloud.langfuse.com and copy the key pair from Settings -> API Keys.
# Leave blank to disable tracing locally; the SDK no-ops when keys are missing.
#
# LANGFUSE_BASE_URL: pick the region that matches the project:
#   EU     -> https://cloud.langfuse.com
#   US     -> https://us.cloud.langfuse.com
#   Japan  -> https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# TypeSafe Jev — optional decision model for S3's screen checks. It scores every
# row on a yes/no meaning question; the LLM judge still writes the evidence on
# every fail. Leave blank and screen checks run as judge checks.
# Key from the console at https://jevmodel.org (the free tier runs jev-1.13.0
# on text, one request at a time). Used by scripts/screen.mjs.
TYPESAFE_API_KEY=

# App keys (WhatsApp, Zoho, model endpoint) live in app/.env — template in app/.env.example.
