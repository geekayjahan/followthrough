# Followthrough connected v0. Copy to app/.env; configure values there only.
# Never commit app/.env. Blank values are deliberately unresolved, not working credentials.
APP_LIVE=false
HOST=127.0.0.1
PORT=4310
APP_URL=http://127.0.0.1:4310
# Hosted only: where the SQLite file and action log live (a mounted volume, e.g. /data). Blank keeps them under app/.
DATA_DIR=
# Hosted only: true behind a proxy (Railway) so login throttling counts each visitor, not the proxy.
TRUST_PROXY=
OWNER_PASSWORD=
# Scheduler may send only after the owner intentionally enables verified brief delivery.
ENABLE_JOBS=false
ENABLE_POLLING=false
# Demo clock: ages every loop by N days for cold checks only, so a brief has content today.
DEMO_AGE_DAYS=
# Held sends: minutes between approval and send (60 in use; 0 for a demo, logged on every send).
DEMO_SEND_DELAY_MINUTES=
# Comma-separated owner test email addresses and verified E.164 numbers (up to five).
OWNER_TEST_EMAILS=
WHATSAPP_TEST_NUMBERS=
WHATSAPP_OWNER_NUMBERS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Pin the version enabled for the Meta app. Research target is v26.0; confirm yours.
GRAPH_API_VERSION=
# Required outside the messaging window; configure the approved template and language.
WHATSAPP_BRIEF_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=
# Fresh Zoho accounts only. Region code must match those accounts, e.g. eu, com, in.
ZOHO_REGION=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM=
ZOHO_BOOKS_ORG_ID=
EXPENSE_ACCOUNT_ID=
CASH_ACCOUNT_ID=
STALL_CUSTOMER_ID=
# Muse Spark Open on Baseten (OpenAI-compatible). MODEL_NAME is the slug in the Baseten dashboard.
# MODEL_BASE_URL=https://inference.baseten.co/v1
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Meta Voice API uses WAV; bundled ffmpeg-static converts OGG. Optional binary override:
VOICE_TRANSCRIBE_KEY=
FFMPEG_PATH=
# Optional second endpoint for receipt photos if Spark Open rejects image input.
VISION_MODEL_BASE_URL=
VISION_MODEL_NAME=
VISION_MODEL_API_KEY=
# The From address for every email to a coffee counterpart (Pinned: Coffee alias).
MAIL_FROM_COFFEE=

INSTAGRAM_USER_ID=

INSTAGRAM_ACCESS_TOKEN=

SYNTHETIC_DATA_APPROVED=false

ZOHO_MAIL_INBOX_ID=

ENRICHMENT_ALLOWED_HOSTS=
# For approved single-body-variable templates outside the 24-hour recipient window.
WHATSAPP_WABA_ID=
WHATSAPP_FOLLOWUP_TEMPLATE=
