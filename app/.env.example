# Followthrough — copy to app/.env and fill in. Never commit app/.env.
APP_LIVE=false                      # set to true by hand only; until then every send goes to the test lists below
OWNER_TEST_EMAILS=                  # comma-separated; every pre-live email is rewritten to one of these
WHATSAPP_TEST_NUMBERS=              # comma-separated E.164; the Cloud API test list (max 5)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=                     # permanent system-user token, not the 24 h quickstart token
WHATSAPP_VERIFY_TOKEN=              # webhook verification string
ZOHO_CLIENT_ID=                     # fresh Zoho account only (TBC)
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_ORG_ID=
MODEL_BASE_URL=                     # the open-weights model served from the Daytona sandbox
MODEL_NAME=
VOICE_TRANSCRIBE_KEY=               # Meta Voice Transcribe (access path open, spec T6)
DAYTONA_API_KEY=
